[Unit]
Description=MetaPlogging Backend API
After=network.target docker.service
Requires=docker.service

[Service]
Type=exec
User=dsem
WorkingDirectory=/data/projects/MetaPlogging/backend
ExecStartPre=/usr/bin/docker compose -f /data/projects/MetaPlogging/backend/docker-compose.yml up -d
ExecStartPre=/bin/bash -c 'until docker compose -f /data/projects/MetaPlogging/backend/docker-compose.yml exec -T db pg_isready -q; do sleep 1; done'
ExecStart=/home/dsem/.local/bin/uv run uvicorn app.main:app --host 0.0.0.0 --port 8000
ExecStop=/usr/bin/docker compose -f /data/projects/MetaPlogging/backend/docker-compose.yml stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
